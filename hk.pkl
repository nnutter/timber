amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

local goChecks = new Mapping<String, Step> {
  ["go-mod-tidy"] = (Builtins.gomod_tidy)
  ["go-fumpt"] {
    glob = "**/*.go"
    check = """
      set -e
      FILES=$(go tool gofumpt -l {{files}})
      if [ -n "$FILES" ]; then
      echo "$FILES"
      exit 1
      fi
      """
    fix = "go tool gofumpt -w {{files}}"
  }
  ["go-imports"] {
    glob = "**/*.go"
    check = """
      set -e
      FILES=$(go tool goimports -l -local $(go list -m) {{files}})
      if [ -n "$FILES" ]; then
      echo "$FILES"
      exit 1
      fi
      """
    fix = "go tool goimports -w -local $(go list -m) {{files}}"
  }
  ["go-fix"] = (Builtins.go_fix)
}

hooks {
  ["check"] {
    steps = goChecks
  }
  ["commit-msg"] {
    fix = true
    steps {
      ["change-id"] {
        fix = "timber review commit-msg \"{{commit_msg_file}}\""
      }
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["gitleaks"] = (Builtins.gitleaks) {
        check = "go tool gitleaks git --redact --pre-commit --staged && tmp=$(mktemp -d) || exit $?; trap 'rm -rf \"$tmp\"' EXIT INT TERM; git diff --cached --name-only -z --diff-filter=ACMRT > \"$tmp/list\" || exit $?; git checkout-index -z --stdin --prefix=\"$tmp/tree/\" < \"$tmp/list\" || exit $?; mkdir -p \"$tmp/tree\" || exit $?; go tool gitleaks dir --redact --verbose --no-banner \"$tmp/tree\" || exit $?"
      }
      ["format"] {
        glob = "*.go"
        fix = "mise run pre-commit {{files}}"
      }
    }
  }
}
